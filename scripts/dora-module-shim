"""Run a dora command with workarounds for dora's `module:` limitations.

- dora expands environment variables in `env:` values but not in `module:`
  paths: https://github.com/dora-rs/dora/issues/3805 . This expands `$VAR`,
  `${VAR}` and `${VAR:-default}` in `module:` paths of the given dataflow.
- dora resolves `path:` in a module relative to the module file, so a command
  name such as `path: dora-openarm` in `modules/x.yaml` isn't found in `PATH`:
  https://github.com/dora-rs/dora/issues/3826 . This copies a module in a
  subdirectory next to the given dataflow and uses the copy. Other relative
  paths in the module aren't adjusted, so they don't work in the copy.

This writes the result to `<name>.shim.yaml` next to the given dataflow, so
that relative paths and the nodes' working directory stay the same, runs dora
on it and removes the written files when dora exits:

    LEADER=webxr dora-module-shim run dataflow.yaml --uv

The dataflow is the first argument after the dora command that names an
existing `.yml`/`.yaml` file. Only `module:` in the given dataflow is handled,
not in module files.

Remove this once dora fixes these issues.
"""

import os
import re
import signal
import subprocess
import sys
from pathlib import Path

MODULE_LINE = re.compile(r"^(\s*(?:-\s+)?module:\s*)(.*)$")
VARIABLE = re.compile(r"\$(?:\{(\w+)(?::-([^}]*))?\}|(\w+))")


def expand_variable(match: re.Match) -> str:
    """Expand one `$VAR`, `${VAR}` or `${VAR:-default}`."""
    name = match.group(1) or match.group(3)
    default = match.group(2)
    value = os.environ.get(name, "")
    if value:
        return value
    if default is not None:
        return default
    raise SystemExit(f"dora-module-shim: environment variable {name} isn't set")


def shim_path(path: Path) -> Path:
    """Return `<name>.shim.yaml` for `<name>.yaml`."""
    return path.with_name(f"{path.stem}.shim{path.suffix}")


def expand(dataflow: Path) -> dict[Path, str]:
    """Return the files to write: the expanded dataflow and module copies."""
    directory = dataflow.parent
    files = {}
    lines = []
    for line in dataflow.read_text().splitlines(keepends=True):
        match = MODULE_LINE.match(line)
        if match:
            prefix, value = match.groups()
            module = Path(VARIABLE.sub(expand_variable, value).strip())
            if module.parent != Path("."):
                copy = shim_path(Path(module.name))
                files[directory / copy] = (directory / module).read_text()
                module = copy
            line = prefix + str(module) + line[match.end() :]
        lines.append(line)
    files[shim_path(dataflow)] = "".join(lines)
    return files


def find_dataflow(args: list[str]) -> int:
    """Return the index of the dataflow file in dora's arguments."""
    for i, arg in enumerate(args[1:], start=1):
        path = Path(arg)
        if path.suffix in (".yml", ".yaml") and path.is_file():
            return i
    raise SystemExit("dora-module-shim: no dataflow .yml/.yaml file is given")


def run_dora(args: list[str]) -> int:
    """Run dora until it exits and return its exit code."""
    process = subprocess.Popen(["dora", *args])
    # Ctrl-C reaches dora too: wait for it to stop instead of exiting first.
    # A handler, not SIG_IGN, because dora would inherit SIG_IGN.
    signal.signal(signal.SIGINT, lambda signum, frame: None)
    signal.signal(signal.SIGTERM, lambda signum, frame: process.terminate())
    return process.wait()


def main() -> None:
    """Expand the dataflow, run dora on it and remove the written files."""
    args = sys.argv[1:]
    if not args:
        print(
            "Usage: dora-module-shim <dora command> <dataflow.yaml> [args...]",
            file=sys.stderr,
        )
        sys.exit(1)

    index = find_dataflow(args)
    dataflow = Path(args[index])
    files = expand(dataflow)
    args[index] = str(shim_path(dataflow))
    try:
        for path, content in files.items():
            path.write_text(content)
        status = run_dora(args)
    finally:
        for path in files:
            path.unlink(missing_ok=True)
    sys.exit(status)


if __name__ == "__main__":
    main()
